{
  "name": "new-family-tree-mobile",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "expo start --clear",
    "pre-submit": "ts-node scripts/pre-submit-check.ts",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:all": "eas build --platform all --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest",
    "submit:all": "eas submit --platform all --latest",
    "deploy": "npm run pre-submit && npm run build:all && npm run submit:all"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "~3.31.1",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "react-native-linear-gradient": "^2.8.3",
    "expo-image-picker": "~15.0.5",
    "expo-camera": "~15.0.10",
    "@supabase/supabase-js": "^2.39.0",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "expo-notifications": "~0.28.1",
    "expo-device": "~6.0.2",
    "expo-constants": "~16.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo-local-authentication": "~14.0.1",
    "expo-secure-store": "~13.0.1",
    "@supabase/realtime-js": "^2.9.3",
    "react-native-gifted-chat": "^2.4.0",
    "dayjs": "^1.11.10",
    "expo-file-system": "~17.0.1",
    "react-native-calendars": "^1.1305.0",
    "lucide-react-native": "^0.344.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/node": "^22",
    "@types/react": "~18.2.45",
    "typescript": "^5.1.3",
    "ts-node": "^10.9.2"
  },
  "private": true
}
